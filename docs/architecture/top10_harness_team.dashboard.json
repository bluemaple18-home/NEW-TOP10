{
  "schema_version": "top10-harness-team-dashboard.v1",
  "project": "TOP10new",
  "purpose": "穩固版 TOP10 daily harness 與研究回圈監控 contract",
  "external_review_workflow": {
    "owner_harness": "com.new-top10.external-review",
    "entrypoint": "scripts/run_external_review_host_runner.sh",
    "controller": "scripts/run_external_review_host_runner.py",
    "schedule": "daily 17:50 after daily OK",
    "run_id": "daily-{run_date}",
    "provider_mode_default": "browser",
    "provider_mode_fallback": "api only by explicit switch",
    "formal_agents": [
      {
        "agent_id": "external_review_harness",
        "harness_role": "主控",
        "responsibility": "確認 daily OK、產生並驗證 review packet、拒送 manifest、寫 host runner status。",
        "scripts": ["scripts/build_external_review_packet.py", "scripts/verify_external_review_packet.py"],
        "success_artifacts": [
          "artifacts/external_review/{run_date}/review_packet_{run_date}.json",
          "artifacts/host_runner/{run_date}/host_runner_status_{run_date}.json"
        ]
      },
      {
        "agent_id": "ai_review_adapter",
        "harness_role": "provider adapter",
        "responsibility": "同一個 host runner 依序操作 ChatGPT 與 Gemini 固定 conversation，收 raw response 並做 normalize / contract verify。",
        "providers": [
          {
            "provider": "chatgpt",
            "adapter": "scripts/review_chatgpt_chrome.sh",
            "fixed_conversation": "TOP10 External Review - ChatGPT PROD",
            "url_marker_env": "TOP10_CHATGPT_URL_PART"
          },
          {
            "provider": "gemini",
            "adapter": "scripts/review_gemini_chrome.sh",
            "fixed_conversation": "TOP10 External Review - Gemini PROD",
            "url_marker_env": "TOP10_GEMINI_URL_PART"
          }
        ],
        "success_artifacts": [
          "artifacts/external_review/{run_date}/chatgpt_raw_{run_date}.txt",
          "artifacts/external_review/{run_date}/chatgpt_response_{run_date}.json",
          "artifacts/external_review/{run_date}/gemini_raw_{run_date}.txt",
          "artifacts/external_review/{run_date}/gemini_response_{run_date}.json"
        ],
        "formal_raw_gate": {
          "min_chars": 500,
          "reject_smoke_marker": true,
          "smoke_artifacts_only": ["chatgpt_smoke_{run_date}.json", "gemini_smoke_{run_date}.json"]
        }
      },
      {
        "agent_id": "disagreement_next_actions",
        "harness_role": "分歧處置",
        "responsibility": "合併兩個外部 AI 的檢核結果，產生分歧、人工複核與研究題目；不得直接改 ranking。",
        "scripts": ["scripts/build_external_review_summary.py", "scripts/verify_external_review_summary.py"],
        "success_artifacts": ["artifacts/external_review/{run_date}/external_review_summary_{run_date}.json"]
      },
      {
        "agent_id": "fog_map",
        "harness_role": "研究交接",
        "responsibility": "消化 external review 分歧成迷霧訊號與研究 queue，不宣告 ranking truth。",
        "scripts": ["scripts/run_top10_fog_map_handoff.py"]
      },
      {
        "agent_id": "ops_reporter",
        "harness_role": "中文回報",
        "responsibility": "送工作進度頻道，只用中文回報狀態、分歧與下一步。",
        "scripts": ["scripts/build_top10_ops_progress_message.py", "scripts/send_top10_ops_report.py"],
        "discord_channel": "ops_progress_channel"
      }
    ],
    "status_policy": [
      {"condition": "chatgpt OK and gemini OK", "ai_review_adapter": "ok", "host_runner": "OK"},
      {"condition": "only one provider OK", "ai_review_adapter": "degraded", "host_runner": "PARTIAL"},
      {"condition": "no provider OK", "ai_review_adapter": "failed", "host_runner": "FAILED"},
      {"condition": "daily is not OK", "external_review_harness": "skipped", "host_runner": "SKIPPED"}
    ],
    "boundaries": [
      "ChatGPT / Gemini 不是獨立 harness；它們是同一條 external review host runner 的 provider adapter。",
      "外部 AI 只能產生檢核、分歧、人工複核與研究假設，不能直接改 ranking、模型或報牌。",
      "smoke test 不得覆蓋正式 raw / response artifact。"
    ]
  },
  "channels": [
    {
      "id": "daily_pick_channel",
      "label": "報牌頻道",
      "owner_agent_id": "daily_push",
      "allowed_message_types": ["daily_top10"],
      "blocked_message_types": ["debug_log", "research_draft", "stop_event", "external_review_raw"]
    },
    {
      "id": "ops_progress_channel",
      "label": "工作進度頻道",
      "owner_agent_id": "ops_reporter",
      "allowed_message_types": ["run_status", "stop_event", "warning", "external_review_disagreement", "next_actions", "blocker"],
      "blocked_message_types": ["ungated_top10_pick"]
    }
  ],
  "status_enum": ["pending", "running", "ok", "warning", "degraded", "skipped", "failed", "blocked"],
  "decision_enum": ["pass", "stop", "degrade", "quarantine", "partial", "accept", "reject", "needs_more_data", "not_applicable"],
  "agents": [
    {
      "id": "harness_runner",
      "index": 1,
      "label": "Harness Runner",
      "lane": "orchestration",
      "responsibility": "啟動 daily loop、建立 run_id、控管 lock/retry/timeout。",
      "inputs": ["schedule_trigger", "manual_trigger", "previous_blockers"],
      "outputs": ["run_manifest", "agent_status_event"],
      "dashboard_metrics": ["status", "run_id", "run_date", "started_at", "finished_at", "duration_seconds", "lock_acquired", "retry_count"],
      "stop_conditions": ["duplicate_run", "lock_timeout", "missing_required_config"]
    },
    {
      "id": "preflight",
      "index": 2,
      "label": "Preflight Bot",
      "lane": "daily",
      "responsibility": "檢查交易日、API、設定、前輪 blocker。",
      "inputs": ["run_manifest", "automation_config", "previous_blockers"],
      "outputs": ["preflight_result", "stop_event"],
      "dashboard_metrics": ["status", "decision", "trading_day", "api_ready", "blocker_count"],
      "stop_conditions": ["not_trading_day_without_backfill", "api_unavailable", "active_blocker"]
    },
    {
      "id": "data_etl",
      "index": 3,
      "label": "Data ETL Bot",
      "lane": "daily",
      "responsibility": "抓 TWSE/TPEX、籌碼、基本面，產生 daily snapshot。",
      "inputs": ["preflight_result", "source_config"],
      "outputs": ["daily_data_snapshot"],
      "dashboard_metrics": ["status", "source_count", "row_count", "snapshot_date", "artifact_paths"],
      "stop_conditions": ["fetch_failed", "snapshot_missing", "source_date_mismatch"]
    },
    {
      "id": "data_quality_gate",
      "index": 4,
      "label": "Data Quality Gate Bot",
      "lane": "daily",
      "responsibility": "檢查日期、筆數、缺值、覆蓋率、股票池完整性。",
      "inputs": ["daily_data_snapshot"],
      "outputs": ["quality_gate_result", "stop_event"],
      "dashboard_metrics": ["status", "decision", "coverage_rate", "missing_rate", "tradable_universe_count"],
      "stop_conditions": ["coverage_below_threshold", "missing_rate_above_threshold", "tradable_universe_incomplete"]
    },
    {
      "id": "ranking",
      "index": 5,
      "label": "Ranking Bot",
      "lane": "daily",
      "responsibility": "產生 Top10、分數、推薦理由、feature snapshot。",
      "inputs": ["quality_gate_result", "daily_data_snapshot"],
      "outputs": ["ranking_result", "feature_snapshot"],
      "dashboard_metrics": ["status", "top10_count", "feature_snapshot_path", "reason_count"],
      "stop_conditions": ["top10_missing", "score_missing", "reason_missing", "feature_snapshot_missing"]
    },
    {
      "id": "anomaly_circuit_breaker",
      "index": 6,
      "label": "Anomaly / Circuit Breaker Bot",
      "lane": "daily",
      "responsibility": "檢查排名劇烈變動、baseline 偏離、不可解釋異常。",
      "inputs": ["ranking_result", "baseline_artifacts"],
      "outputs": ["anomaly_decision", "stop_event", "degraded_decision"],
      "dashboard_metrics": ["status", "decision", "rank_churn", "baseline_delta", "unexplained_count"],
      "stop_conditions": ["unexplained_ranking_shift", "baseline_delta_above_threshold", "critical_blocker"]
    },
    {
      "id": "daily_push",
      "index": 7,
      "label": "Daily Push Bot",
      "lane": "publish",
      "responsibility": "推送通過 gate 的 Top10 到原本報牌頻道。",
      "inputs": ["anomaly_decision", "ranking_result", "publish_payload"],
      "outputs": ["daily_pick_message", "send_receipt"],
      "dashboard_metrics": ["status", "discord_channel", "message_path", "send_receipt_path", "sent_at"],
      "discord_channel": "daily_pick_channel",
      "stop_conditions": ["publish_payload_missing", "send_failed", "send_receipt_missing"]
    },
    {
      "id": "outcome_tracker",
      "index": 8,
      "label": "Outcome Tracker Bot",
      "lane": "post_daily",
      "responsibility": "追蹤命中率、報酬、誤報、人工標記，把後驗結果回流。",
      "inputs": ["send_receipt", "market_outcome_data", "manual_labels"],
      "outputs": ["outcome_artifact", "fog_signals"],
      "dashboard_metrics": ["status", "hit_rate", "return_summary", "false_positive_count", "manual_label_count"],
      "stop_conditions": ["outcome_data_missing"]
    },
    {
      "id": "external_review_harness",
      "index": 9,
      "label": "External Review Harness Bot",
      "lane": "post_daily",
      "responsibility": "daily OK 後包 review packet，啟動外部 review。",
      "inputs": ["automation_status", "ranking_result", "daily_pick_message"],
      "outputs": ["verified_review_packet", "host_runner_status"],
      "dashboard_metrics": ["status", "daily_status_ok", "packet_verified", "manifest_refused", "artifact_paths"],
      "artifact_paths": [
        "artifacts/host_runner/{run_date}/host_runner_status_{run_date}.json",
        "artifacts/host_runner/{run_date}/host_runner_summary_{run_date}.json",
        "artifacts/external_review/{run_date}/review_packet_{run_date}.json"
      ],
      "stop_conditions": ["daily_status_not_ok", "packet_verify_failed"]
    },
    {
      "id": "ai_review_adapter",
      "index": 10,
      "label": "AI Review Adapter Bot",
      "lane": "post_daily",
      "responsibility": "以固定 browser conversation 分別送 ChatGPT/Gemini 並收回標準格式；官方 API 僅作明確切換備援。",
      "inputs": ["verified_review_packet"],
      "outputs": ["chatgpt_response", "gemini_response", "provider_collect_status"],
      "dashboard_metrics": ["status", "chatgpt_status", "gemini_status", "valid_provider_count", "invalid_providers"],
      "providers": ["chatgpt", "gemini"],
      "artifact_paths": [
        "artifacts/external_review/{run_date}/chatgpt_response_{run_date}.json",
        "artifacts/external_review/{run_date}/gemini_response_{run_date}.json"
      ],
      "stop_conditions": ["api_key_missing", "all_providers_failed", "provider_response_invalid"]
    },
    {
      "id": "disagreement_next_actions",
      "index": 11,
      "label": "Disagreement / Next Actions Bot",
      "lane": "research_trigger",
      "responsibility": "找出外部 AI 跟我們完全相反之處，產生追蹤、隔離、人工確認或研究卡。",
      "inputs": ["external_review_summary", "outcome_artifact"],
      "outputs": ["disagreement_report", "next_actions", "research_cards"],
      "dashboard_metrics": ["status", "disagreement_count", "needs_human_review", "research_card_count", "quarantine_count"],
      "artifact_paths": [
        "artifacts/external_review/{run_date}/external_review_summary_{run_date}.json"
      ],
      "stop_conditions": ["summary_verify_failed"]
    },
    {
      "id": "fog_map",
      "index": 12,
      "label": "Fog Map Bot",
      "lane": "research_handoff",
      "responsibility": "維護研究迷霧、挑出下一輪研究隊列，並把研究 worker 的結果回寫成地圖與下一輪 blocker。",
      "inputs": ["outcome_artifact", "external_review_summary", "research_cards", "autonomous_research_run_history"],
      "outputs": ["research_queue_handoff", "research_fog_map", "research_map_html", "fog_signals"],
      "dashboard_metrics": ["status", "decision", "refresh_attempted", "research_quota_attempted", "command_count", "map_verified", "artifact_paths"],
      "artifact_paths": [
        "artifacts/autonomous_research/research_campaign_progress_{run_date}.json",
        "artifacts/research_map/research_fog_map_{run_date}.json",
        "artifacts/research_map/research_fog_map_latest.json",
        "artifacts/research_map/research_fog_map_verification_latest.json",
        "artifacts/research_map/index.html"
      ],
      "stop_conditions": ["research_map_refresh_failed", "research_map_verify_failed", "run_history_unreadable"]
    },
    {
      "id": "research_worker",
      "index": 13,
      "label": "Autonomous Research Worker Bot",
      "lane": "research_handoff",
      "responsibility": "依 Fog Map queue 每輪執行安全研究 quota，只跑白名單回測，不訓練模型、不改 ranking。",
      "inputs": ["research_queue_handoff", "external_review_summary", "autonomous_research_manager_state"],
      "outputs": ["daily_research_quota_artifact", "research_run_history", "research_evidence"],
      "dashboard_metrics": ["status", "decision", "quota", "from_queue", "artifact_paths", "exit_code"],
      "artifact_paths": [
        "artifacts/autonomous_research/autonomous_research_daily_quota_{run_date}.json",
        "artifacts/autonomous_research/daily_research_quota_verification_latest.json",
        "artifacts/autonomous_research/run_history.jsonl"
      ],
      "stop_conditions": ["quota_run_failed", "quota_verification_failed", "research_queue_missing"]
    },
    {
      "id": "ops_reporter",
      "index": 14,
      "label": "Ops Reporter Bot",
      "lane": "ops",
      "responsibility": "回報工作進度頻道，產生下一輪 blocker。",
      "inputs": ["stop_event", "host_runner_status", "external_review_summary", "next_actions", "research_fog_map", "daily_research_quota_artifact", "research_decision_brief"],
      "outputs": ["ops_progress_message", "blocker_list", "pm_decision_requests"],
      "dashboard_metrics": ["status", "discord_channel", "message_path", "blocker_count", "next_action_count", "decision_request_count"],
      "artifact_paths": [
        "artifacts/research_decisions/research_decision_brief_{run_date}.json",
        "artifacts/research_decisions/research_decision_brief_{run_date}.md"
      ],
      "discord_channel": "ops_progress_channel",
      "stop_conditions": ["ops_message_render_failed", "ops_send_failed_without_local_artifact"]
    }
  ],
  "flows": [
    {"from": "harness_runner", "to": "preflight", "kind": "daily", "label": "run request"},
    {"from": "preflight", "to": "data_etl", "kind": "daily", "label": "pass"},
    {"from": "data_etl", "to": "data_quality_gate", "kind": "daily", "label": "snapshot"},
    {"from": "data_quality_gate", "to": "ranking", "kind": "daily", "label": "quality pass"},
    {"from": "ranking", "to": "anomaly_circuit_breaker", "kind": "daily", "label": "ranking result"},
    {"from": "anomaly_circuit_breaker", "to": "daily_push", "kind": "daily", "label": "ok"},
    {"from": "daily_push", "to": "daily_pick_channel", "kind": "discord", "label": "daily Top10 only"},
    {"from": "daily_push", "to": "outcome_tracker", "kind": "post_daily", "label": "send receipt"},
    {"from": "outcome_tracker", "to": "external_review_harness", "kind": "post_daily", "label": "daily OK"},
    {"from": "external_review_harness", "to": "ai_review_adapter", "kind": "post_daily", "label": "verified packet"},
    {"from": "ai_review_adapter", "to": "disagreement_next_actions", "kind": "research_trigger", "label": "review summary"},
    {"from": "outcome_tracker", "to": "fog_map", "kind": "research_handoff", "label": "outcome fog signals"},
    {"from": "anomaly_circuit_breaker", "to": "fog_map", "kind": "research_handoff", "label": "anomaly fog signal"},
    {"from": "disagreement_next_actions", "to": "fog_map", "kind": "research_handoff", "label": "review disagreement to fog map"},
    {"from": "fog_map", "to": "research_worker", "kind": "research_loop", "label": "research quota queue"},
    {"from": "research_worker", "to": "fog_map", "kind": "research_loop", "label": "quota evidence updates map"},
    {"from": "fog_map", "to": "ops_reporter", "kind": "ops", "label": "research map status and next blockers"},
    {"from": "ops_reporter", "to": "ops_progress_channel", "kind": "discord", "label": "progress report"},
    {"from": "ops_progress_channel", "to": "harness_runner", "kind": "feedback", "label": "next-run blockers"},
    {"from": "preflight", "to": "ops_reporter", "kind": "stop", "label": "stop event"},
    {"from": "data_quality_gate", "to": "ops_reporter", "kind": "stop", "label": "stop event"},
    {"from": "anomaly_circuit_breaker", "to": "ops_reporter", "kind": "stop", "label": "stop/degrade event"}
  ],
  "research_loop": [
    "fog_map",
    "research_card",
    "experiment",
    "validation",
    "decision",
    "merge_policy",
    "evidence_ledger",
    "ranking"
  ],
  "owner_bot_mapping": [
    {"owner_bot": "Harness Runner", "formal_agents": ["harness_runner"], "boundary": "run_id, lock, schedule"},
    {"owner_bot": "Daily Pipeline Bot", "formal_agents": ["preflight", "data_etl", "data_quality_gate"], "boundary": "data readiness"},
    {"owner_bot": "Ranking Bot", "formal_agents": ["ranking", "anomaly_circuit_breaker"], "boundary": "ranking and publish gate"},
    {"owner_bot": "Daily Push Bot", "formal_agents": ["daily_push"], "boundary": "daily pick channel"},
    {"owner_bot": "Outcome Tracker Bot", "formal_agents": ["outcome_tracker"], "boundary": "post-daily evidence"},
    {"owner_bot": "External Review Bot", "formal_agents": ["external_review_harness", "ai_review_adapter", "disagreement_next_actions"], "boundary": "external AI disagreement"},
    {"owner_bot": "Fog Map Bot", "formal_agents": ["fog_map"], "boundary": "research map and queue; linkage_ok is not replay progress"},
    {"owner_bot": "Research Worker Bot", "formal_agents": ["research_worker"], "boundary": "daily quota and representative replay progress"},
    {"owner_bot": "Ops Reporter Bot", "formal_agents": ["ops_reporter"], "boundary": "ops progress channel and next-run blockers"}
  ],
  "event_sources": [
    {"agent_id": "harness_runner", "writer": "scripts/record_top10_daily_status_events.py", "source_artifacts": ["artifacts/automation_status.json"], "normal_wait": ["non-trading-day skipped", "dry-run skipped"], "missing_is_attention_when": "daily run triggered but automation_status is missing"},
    {"agent_id": "preflight", "writer": "scripts/record_top10_daily_status_events.py", "source_artifacts": ["artifacts/automation_status.json"], "normal_wait": ["trading-day gate skipped"], "missing_is_attention_when": "daily run exists but preflight steps are missing"},
    {"agent_id": "data_etl", "writer": "scripts/record_top10_daily_status_events.py", "source_artifacts": ["artifacts/automation_status.json", "dataset artifacts"], "normal_wait": ["preflight skipped or failed"], "missing_is_attention_when": "preflight passed but ETL step or snapshot is missing"},
    {"agent_id": "data_quality_gate", "writer": "scripts/record_top10_daily_status_events.py", "source_artifacts": ["artifacts/automation_status.json", "dataset artifacts"], "normal_wait": ["ETL skipped or failed"], "missing_is_attention_when": "ETL passed but quality gate event is missing"},
    {"agent_id": "ranking", "writer": "scripts/record_top10_daily_status_events.py", "source_artifacts": ["ranking_artifact", "expected_ranking_artifact"], "normal_wait": ["data_quality_gate did not pass"], "missing_is_attention_when": "quality gate passed but ranking artifact/event is missing"},
    {"agent_id": "anomaly_circuit_breaker", "writer": "scripts/record_top10_daily_status_events.py", "source_artifacts": ["decision_quality_artifact"], "normal_wait": ["ranking skipped or failed"], "missing_is_attention_when": "ranking passed but circuit evidence is missing"},
    {"agent_id": "daily_push", "writer": "scripts/record_top10_publish_event.py", "source_artifacts": ["publish message", "send receipt", "artifacts/automation_status.json"], "normal_wait": ["daily did not pass publish gate"], "missing_is_attention_when": "anomaly gate passed but publish event or send receipt is missing"},
    {"agent_id": "outcome_tracker", "writer": "scripts/record_top10_daily_status_events.py", "source_artifacts": ["market_context_artifact", "candidate persistence", "weekly snapshot"], "normal_wait": ["realized outcome is not mature yet"], "missing_is_attention_when": "send receipt exists and outcome should be tracked but no artifact appears"},
    {"agent_id": "external_review_harness", "writer": "scripts/run_external_review_host_runner.py", "source_artifacts": ["artifacts/host_runner/{run_date}/host_runner_status_{run_date}.json", "artifacts/external_review/{run_date}/review_packet_{run_date}.json"], "normal_wait": ["daily status is not OK"], "missing_is_attention_when": "daily OK but host runner status or packet event is missing"},
    {"agent_id": "ai_review_adapter", "writer": "scripts/run_external_review_host_runner.py", "source_artifacts": ["chatgpt_response", "gemini_response", "provider collect status"], "normal_wait": ["single provider skipped or failed can be degraded/partial"], "missing_is_attention_when": "all providers failed or adapter event is missing after packet verification"},
    {"agent_id": "disagreement_next_actions", "writer": "scripts/run_external_review_host_runner.py", "source_artifacts": ["artifacts/external_review/{run_date}/external_review_summary_{run_date}.json"], "normal_wait": ["needs_human_review can be warning"], "missing_is_attention_when": "summary verification failed or daily OK has no disagreement event"},
    {"agent_id": "fog_map", "writer": "scripts/run_top10_fog_map_handoff.py", "source_artifacts": ["research campaign progress", "research fog map", "fog map verification"], "normal_wait": ["external review skipped", "explicit fog handoff skip"], "missing_is_attention_when": "review/outcome signal exists but fog_map event is missing"},
    {"agent_id": "research_worker", "writer": "scripts/run_top10_fog_map_handoff.py", "source_artifacts": ["daily quota artifact", "daily quota verification", "run_history.jsonl"], "normal_wait": ["TOP10_SKIP_RESEARCH_QUOTA=1", "empty research queue"], "missing_is_attention_when": "research queue exists but quota/replay event is missing"},
    {"agent_id": "ops_reporter", "writer": "scripts/record_top10_daily_status_events.py and scripts/send_top10_ops_report.py", "source_artifacts": ["rollup", "ops progress message", "research decision brief"], "normal_wait": ["local ops message exists but send is pending can be warning"], "missing_is_attention_when": "stop/degraded status exists but no ops event or local message exists"}
  ],
  "pending_policy": {
    "normal_pending": ["upstream has not handed off", "realized outcome is not mature", "external review has not reached schedule time"],
    "attention_pending": ["upstream status is ok/pass and this agent should run", "event is missing after expected writer completed"],
    "skipped_requires": ["failure_reason or explicit skip reason", "next_action when skip affects a downstream lane"]
  },
  "status_publish_policy": [
    {"upstream_status": "ok", "daily_publish": "allowed", "external_review": "allowed", "fog_research": "allowed", "ops_progress": "success summary"},
    {"upstream_status": "warning", "daily_publish": "allowed only when ranking gate remains complete", "external_review": "allowed with partial/human-review marker", "fog_research": "allowed as risk signal", "ops_progress": "required warning"},
    {"upstream_status": "degraded", "daily_publish": "blocked by default unless degradation is non-core and publish gate is complete", "external_review": "allowed as review, not success proof", "fog_research": "allowed as blocker/signal", "ops_progress": "required degraded next_action"},
    {"upstream_status": "skipped", "daily_publish": "blocked", "external_review": "skipped when daily is not OK", "fog_research": "wait only", "ops_progress": "required skip reason"},
    {"upstream_status": "failed_or_blocked", "daily_publish": "blocked", "external_review": "blocked except failure/debug review", "fog_research": "blocker only; no ranking merge", "ops_progress": "required fail-loud"}
  ],
  "research_gate_contract": [
    {"gate": "research_card", "artifact": "docs/tasks/<task_id>.md or artifacts/autonomous_research/research_cards_{run_date}.jsonl", "validator": "must include hypothesis, input_refs, blocked_conditions", "allowed_action": "queue research only"},
    {"gate": "experiment", "artifact": "artifacts/autonomous_research/experiments/<experiment_id>/run_manifest.json", "validator": "whitelisted runner, fixed config, no production model change", "allowed_action": "produce evidence only"},
    {"gate": "validation", "artifact": "artifacts/autonomous_research/experiments/<experiment_id>/validation.json", "validator": "complete evidence, no leakage, comparable baseline", "allowed_action": "passed/failed/needs_more_data"},
    {"gate": "decision", "artifact": "artifacts/autonomous_research/decisions/<decision_id>.json", "validator": "decision enum accept/reject/quarantine/needs_more_data", "allowed_action": "accept can proceed to merge policy"},
    {"gate": "merge_policy", "artifact": "artifacts/autonomous_research/merge_policy/<decision_id>.json", "validator": "impact scope, threshold, rollback condition", "allowed_action": "open ranking/model implementation card"},
    {"gate": "evidence_ledger", "artifact": "artifacts/autonomous_research/evidence_ledger/<decision_id>.json", "validator": "complete ledger with repo-relative paths", "allowed_action": "handoff to Ranking Bot for controlled evaluation"}
  ],
  "memory_boundary": {
    "allowed": ["recall prior blockers before run", "store milestone handoff after root question/blocker/fork changes", "produce memory candidates or review notes"],
    "forbidden": ["declare run truth", "declare ranking truth", "declare replay progress", "directly modify ranking/model", "directly write canonical memory"]
  },
  "event_contract": {
    "required_fields": [
      "schema_version",
      "run_id",
      "run_date",
      "agent_id",
      "status",
      "decision",
      "started_at",
      "finished_at",
      "duration_seconds",
      "input_refs",
      "artifact_paths",
      "failure_reason",
      "next_action"
    ],
    "schema_version": "top10-agent-status-event.v1"
  }
}

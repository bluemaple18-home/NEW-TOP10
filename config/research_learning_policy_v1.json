{
  "schema_version": "research-learning-policy.v1",
  "policy_version": "matched-parameter-learning.v1",
  "numeric_parameters": ["horizon", "stop_loss_pct", "take_profit_pct", "max_group_exposure"],
  "min_independent_matched_contrasts": 3,
  "min_distinct_lineages": 2,
  "min_interaction_contrasts": 2,
  "min_robust_region_points": 3,
  "min_global_regimes": 2,
  "direction_consistency_threshold": 0.7,
  "flat_consistency_threshold": 0.8,
  "effect_deadbands": {"score": 0.01, "total_return": 0.005, "max_drawdown": 0.01, "win_rate": 0.02, "avg_trade_return": 0.001},
  "robust_basin": {"score_range_tolerance": 0.02, "minimum_total_return": 0.0, "max_drawdown_limit": -0.25},
  "sharp_peak": {"minimum_score_drop_each_side": 0.03}
}

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.new-top10.pm-research-harness</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_DIR__/scripts/run_with_storage_guard.sh</string>
        <string>pm-research-harness</string>
        <string>/bin/bash</string>
        <string>__PROJECT_DIR__/scripts/run_pm_research_harness_loop.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>TOP10_PM_RESEARCH_ENABLED</key>
        <string>0</string>
        <key>TOP10_RESEARCH_QUEUE_OWNER</key>
        <string>fog_worker</string>
        <key>TOP10_PM_RESEARCH_SEND_CARDS</key>
        <string>0</string>
        <key>TOP10_PM_RESEARCH_DRY_RUN_SEND</key>
        <string>1</string>
        <key>TOP10_PM_RESEARCH_MAX_CONTINUATION_RUNS</key>
        <string>8</string>
        <key>TOP10_PM_RESEARCH_MIN_QUEUE_DEPTH</key>
        <string>12</string>
        <key>TOP10_PM_RESEARCH_DISCOVERY_MAX_TOPICS</key>
        <string>30</string>
    </dict>

    <key>StartInterval</key>
    <integer>900</integer>

    <key>StandardOutPath</key>
    <string>/dev/null</string>

    <key>StandardErrorPath</key>
    <string>/dev/null</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>

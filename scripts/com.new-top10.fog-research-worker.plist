<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.new-top10.fog-research-worker</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_DIR__/scripts/run_with_storage_guard.sh</string>
        <string>fog-research-worker</string>
        <string>/bin/bash</string>
        <string>__PROJECT_DIR__/scripts/run_fog_research_worker.sh</string>
    </array>

    <key>StartInterval</key>
    <integer>900</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>TOP10_RESEARCH_QUEUE_OWNER</key>
        <string>fog_worker</string>
        <key>TOP10_FOG_RESEARCH_MAX_RETRIES</key>
        <string>3</string>
        <key>TOP10_FOG_RESEARCH_RETRY_BACKOFF_SECONDS</key>
        <string>30</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/dev/null</string>

    <key>StandardErrorPath</key>
    <string>/dev/null</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
